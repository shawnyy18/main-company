# Optional: trackers load only after the visitor consents to their category.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Required for landing-page project inquiries. LEADS_FROM_EMAIL must use a
# domain verified in Resend, for example: FSK Codehouse <leads@fskcodehouse.com>
RESEND_API_KEY=re_xxxxxxxxx
LEADS_TO_EMAIL=hello@fskcodehouse.com
LEADS_FROM_EMAIL=FSK Codehouse <leads@fskcodehouse.com>

# Blog — all optional. The blog works fully without any of these.

# Google AdSense. Ad slots render nothing at all until BOTH are set, so the
# blog stays clean until you're approved and ready.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=0000000000

# Newsletter. The sign-up form is hidden until an endpoint is configured.
# Must accept POST { "email": string }.
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://example.com/api/subscribe
